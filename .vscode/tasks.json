{
  // For more information, visit: https://go.microsoft.com/fwlink/?LinkId=733558
  "version": "2.0.0",
  "tasks": [
    {
      "type": "npm",
      "script": "start",
      "isBackground": true,
      "problemMatcher": {
        "owner": "typescript",
        "pattern": "$tsc",
        "background": {
          "activeOnStart": true,
          "beginsPattern": {
            "regexp": "Changes detected"
          },
          "endsPattern": {
            "regexp": "bundle generation (complete|failed)"
          }
        }
      }
    },
    {
      "type": "npm",
      "script": "test",
      "isBackground": true,
      "problemMatcher": {
        "owner": "typescript",
        "pattern": "$tsc",
        "background": {
          "activeOnStart": true,
          "beginsPattern": {
            "regexp": "Changes detected"
          },
          "endsPattern": {
            "regexp": "bundle generation (complete|failed)"
          }
        }
      }
    },
    {
      "type": "npm",
      "script": "css:preview:watch",
      "label": "css: watch utility class preview",
      "detail": "Compiles src/styles/_utilities.scss to .vscode/utilities-preview.css so editors can autocomplete utility class names.",
      "isBackground": true,
      "presentation": {
        "reveal": "silent"
      },
      "problemMatcher": {
        "owner": "css",
        "pattern": {
          "regexp": "^(.*)$",
          "file": 1,
          "location": 1,
          "message": 1
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Sass is watching for changes",
          "endsPattern": "Sass is watching for changes"
        }
      },
      "runOptions": {
        "runOn": "folderOpen"
      }
    }
  ]
}
