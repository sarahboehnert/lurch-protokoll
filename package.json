{
  "name": "lurch-protokoll",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "ng lint",
    "format": "prettier --write \"src/**/*.{ts,html,scss}\"",
    "format:check": "prettier --check \"src/**/*.{ts,html,scss}\"",
    "css:preview": "sass src/styles/_utilities.scss .vscode/utilities-preview.css --no-source-map",
    "css:preview:watch": "sass --watch src/styles/_utilities.scss .vscode/utilities-preview.css --no-source-map"
  },
  "private": true,
  "dependencies": {
    "@angular/cdk": "22.0.5",
    "@angular/common": "22.0.7",
    "@angular/compiler": "22.0.7",
    "@angular/core": "22.0.7",
    "@angular/forms": "22.0.7",
    "@angular/material": "22.0.5",
    "@angular/platform-browser": "22.0.7",
    "@angular/router": "22.0.7",
    "@ngrx/signals": "22.0.0-rc.0",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular/build": "22.0.7",
    "@angular/cli": "22.0.7",
    "@angular/compiler-cli": "22.0.7",
    "@eslint/js": "10.0.1",
    "angular-eslint": "22.1.0",
    "eslint": "10.7.0",
    "eslint-config-prettier": "10.1.8",
    "jsdom": "29.1.1",
    "prettier": "3.9.5",
    "sass": "1.99.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.62.1",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": "^24.0.0",
    "npm": "^11.3.0"
  }
}
